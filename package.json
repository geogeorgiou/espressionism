{
  "name": "espressionism",
  "version": "0.1.0",
  "private": true,
  "description": "Espressionism: find out when an espresso machine pays for itself. Compare your café habit with brewing at home: break-even, yearly spend and the real cost per cup.",
  "keywords": [
    "break-even",
    "calculator",
    "coffee",
    "espresso",
    "pixel-art",
    "tanstack",
    "typescript"
  ],
  "license": "MIT",
  "author": "Georgios Georgiou",
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:client": "vp run --filter @espressionism/client dev",
    "build": "vp run -r --cache build",
    "type-check": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "lint:boundaries": "depcruise --config .dependency-cruiser.mjs --output-type err-long packages api",
    "lint:actions": "scripts/lint-actions.sh",
    "actions:up": "scripts/actions-up.sh && pnpm lint:actions",
    "actions:outdated": "scripts/actions-up.sh --dry-run",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "docs:architecture": "node scripts/generate-architecture.mjs",
    "docs:boundaries": "node scripts/generate-boundaries.mjs",
    "check": "vp check",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:api": "node --no-experimental-detect-module scripts/check-api.mjs",
    "test:unit": "vp run -r test:unit",
    "test:tooling": "vp test run",
    "test:e2e": "vp run -r test:e2e",
    "test:mutation": "node scripts/mutation.ts",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@espressionism/agent": "workspace:*"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "catalog:",
    "actions-up": "catalog:",
    "dependency-cruiser": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@10.28.0"
}
