# Copy to packages/client/.env (gitignored) for `pnpm dev` / `vp preview`.
# Server-side only: the Vite agent plugin reads these with loadEnv. Never
# rename them with a VITE_ prefix, which would ship them to the browser.
# On Vercel, add the key as a Secret environment variable instead.

# Google AI Studio API key (restrict it to the Gemini API). Leave empty to
# keep Robospresso's placeholder reply.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=
